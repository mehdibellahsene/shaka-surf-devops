# Identifiants AWS pour le deploiement reel (Terraform + Ansible).
#
# Copier ce fichier en .env (gitignore) puis renseigner de vraies valeurs :
#   cp .env.example .env
#
# Charger les variables avant de lancer Terraform :
#   set -a; source .env; set +a
#
# Terraform et l'AWS CLI lisent automatiquement ces variables : aucune cle
# statique n'apparait dans le code ni dans terraform.tfvars.
# Ne jamais committer le fichier .env rempli ; seul .env.example est versionne.

AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Doit correspondre a la variable region de terraform.tfvars (defaut : eu-west-3).
AWS_DEFAULT_REGION=eu-west-3
AWS_REGION=eu-west-3

# A decommenter uniquement pour des identifiants temporaires (SSO, role assume).
# AWS_SESSION_TOKEN=
