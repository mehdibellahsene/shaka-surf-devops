# GÉRÉ PAR ANSIBLE — rôle app. Valeurs issues d'Ansible Vault.
# Ne contient aucun secret en clair dans le dépôt (rendu à l'exécution).

# --- PostgreSQL (VM base de données dédiée) ---
DB_HOST={{ db_host }}
DB_NAME={{ postgres_db }}
DB_USER={{ postgres_app_user }}
DB_PASSWORD={{ vault_postgres_password }}

# --- Identité de l'instance (affichée par /api/whoami) ---
INSTANCE_NAME={{ inventory_hostname }}
