# GÉRÉ PAR ANSIBLE — rôle app. Valeurs issues d'Ansible Vault.
# Ne contient aucun secret en clair dans le dépôt (rendu à l'exécution).

# --- PostgreSQL (VM base de données dédiée) ---
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ postgres_db }}
DB_HOST={{ db_host }}

# --- Supabase / GoTrue / PostgREST ---
JWT_SECRET={{ vault_jwt_secret }}
ANON_KEY={{ vault_anon_key }}
SERVICE_ROLE_KEY={{ vault_service_role_key }}

# --- URLs publiques (via le load balancer) ---
API_EXTERNAL_URL={{ public_site_url }}
SITE_URL={{ public_site_url }}
ADDITIONAL_REDIRECT_URLS={{ public_site_url }}/**
STUDIO_PORT=9920
NEXT_PUBLIC_SUPABASE_URL={{ public_site_url }}
NEXT_PUBLIC_SUPABASE_ANON_KEY={{ vault_anon_key }}
NEXT_PUBLIC_APP_URL={{ public_site_url }}
NEXT_PUBLIC_BACKEND_URL={{ public_site_url }}/api

# --- Intégrations tierces (optionnelles) ---
STRIPE_SECRET_KEY={{ vault_stripe_secret_key | default('') }}
STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret | default('') }}
BREVO_API_KEY={{ vault_brevo_api_key | default('') }}
SMSMODE_API_KEY={{ vault_smsmode_api_key | default('') }}
