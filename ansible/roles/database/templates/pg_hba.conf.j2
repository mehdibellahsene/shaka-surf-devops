# GÉRÉ PAR ANSIBLE — rôle database
# Accès local + réseau applicatif uniquement. Le Security Group AWS limite déjà
# le port 5432 au SG des applications ; pg_hba ajoute une seconde barrière.

# TYPE  DATABASE  USER      ADDRESS              METHOD
local   all       postgres                       peer
local   all       all                            scram-sha-256
host    all       all       127.0.0.1/32         scram-sha-256
host    all       all       ::1/128              scram-sha-256

# Réseau applicatif (VPC) : uniquement l'utilisateur applicatif sur sa base.
host    {{ postgres_db }}   {{ postgres_app_user }}   {{ db_allowed_cidr }}   scram-sha-256
