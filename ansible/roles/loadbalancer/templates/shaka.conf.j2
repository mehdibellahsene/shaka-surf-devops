# GÉRÉ PAR ANSIBLE — rôle loadbalancer.
# Reverse-proxy + répartition round-robin sur les VMs applicatives.
# certbot ajoute/gère les directives TLS (443) sur ce même server_name.

upstream shaka_app {
{% for ip in app_backends.split(',') if ip | trim | length > 0 %}
    server {{ ip | trim }}:{{ app_backend_port }};
{% endfor %}
}

server {
    listen 80;
    server_name {{ lb_domain }};

    # Laisser passer le challenge ACME (renouvellement Let's Encrypt).
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://shaka_app;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
